# --- Twilio (WhatsApp Sandbox) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- GitHub Models (OpenAI-compatible, free con Student Pack) ---
# Crea un PAT con scope `models:read` en:
#   https://github.com/settings/personal-access-tokens/new
# Endpoint por defecto: https://models.github.ai/inference
GITHUB_TOKEN=
# (alias opcional) GITHUB_MODELS_TOKEN=
CHAT_MODEL=openai/gpt-4o-mini
EMBED_MODEL=openai/text-embedding-3-small

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- App ---
ANON_HASH_SALT=
DASHBOARD_BASIC_AUTH=admin:cambiame
PUBLIC_BASE_URL=http://localhost:3000

# --- RAG tuning ---
RAG_TOP_K=5
# Cosine similarity mínimo del retrieval. 0.30 funciona bien con el corpus
# semilla (15 chunks). Si amplías el corpus a 200+ chunks, sube a 0.45–0.55.
RAG_MIN_SCORE=0.30
